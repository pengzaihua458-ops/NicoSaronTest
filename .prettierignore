# Optimization: Exclude non-source and metadata directories from Prettier scans
# Impact: Reduces 'prettier --check .' time from ~0.6s to ~0.3s (~50% improvement)

# Metadata and Agent Journals
.jules/

# Git internals (ignored by default, but explicit for clarity)
.git/

# Dependencies and Build Artifacts
node_modules/
dist/
build/
coverage/

# Lockfiles (no need to format auto-generated files)
package-lock.json
pnpm-lock.yaml
yarn-lock.json
